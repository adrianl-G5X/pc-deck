          "icon": "camera",
          "page": "Jeux",
          "action": {
            "type": "keys",
            "keys": "win+alt+g"
          }
        },
        {
          "id": "jeu-micro",
          "label": "Micro",
          "icon": "mic",
          "page": "Jeux",
          "action": {
            "type": "mic"
          }
        },
        {
          "id": "jeu-son",

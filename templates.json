    {
      "id": "apple-music",
      "label": "Apple Music",
      "description": "Bouton qui ouvre ou affiche Apple Music sur le 2e écran, et interrupteur « Son sur Apple Music ».",
      "audioApp": {
        "label": "Apple Music",
        "processes": [
          "AppleMusic",
          "AMPLibraryAgent"
        ]
      },
      "buttons": [
        {
          "id": "apple-music",
          "label": "Apple Music",
          "icon": "music",
          "action": {
            "type": "window",
            "process": "AppleMusic",
            "screen": "secondary",
            "ifNotRunning": {
              "type": "app",
              "appId": "AppleInc.AppleMusicWin_nzyj5cx40ttqa!App"
            }
          }
        }
      ]
    },
    {
      "id": "discord-mute",
      "label": "Discord (micro et casque)",
      "description": "Deux interrupteurs : micro et casque. Dans Discord : Paramètres > Raccourcis, ajouter « Activer/désactiver la sourdine » avec Ctrl + Maj + Alt + M, et « Activer/désactiver le mode sourd » avec Ctrl + Maj + Alt + D.",
      "toggles": [
        {
          "id": "discord-micro",
          "label": "Micro Discord",
          "style": "mic",
          "action": {
            "type": "keys",
            "keys": "ctrl+shift+alt+m"
          }
        },
        {
          "id": "discord-casque",
          "label": "Casque Discord",
          "action": {
            "type": "keys",
            "keys": "ctrl+shift+alt+d"
          }
        }
      ]

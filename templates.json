    {
      "id": "gmail",
      "label": "Gmail",
      "description": "Affiche l'onglet Gmail ; un 2e appui ouvre un nouvel onglet. Demande l'extension PC Deck du navigateur.",
      "requires": "extension",
      "buttons": [
        {
          "id": "gmail",
          "label": "Gmail",
          "icon": "mail",
          "action": {
            "type": "tab",
            "url": "https://mail.google.com",
            "match": "https://mail.google.com/*"
          }
        }
      ]
    },
    {
      "id": "icloud",
      "label": "iCloud",
      "description": "Affiche l'onglet iCloud ; un 2e appui ouvre un nouvel onglet. Demande l'extension PC Deck du navigateur.",
      "requires": "extension",
      "buttons": [
        {
          "id": "icloud",
          "label": "iCloud",
          "icon": "cloud",
          "action": {
            "type": "tab",
            "url": "https://www.icloud.com",
            "match": "https://*.icloud.com/*"
          }
        }
      ]
    }

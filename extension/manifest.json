{
  "manifest_version": 3,
  "name": "PC Deck – onglets",
  "description": "Permet aux boutons PC Deck de retrouver un onglet déjà ouvert (Gmail, iCloud…) ou d'en ouvrir un nouveau.",
  "version": "1.1.1",
  "permissions": ["tabs", "alarms"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "browser_specific_settings": {
    "gecko": {
      "id": "onglets@pcdeck.local",
      "update_url": "https://raw.githubusercontent.com/adrianl-G5X/pc-deck/main/extension/updates.json",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" },
  "icons": { "192": "icon-128.png" }
}
